# WhiteNight runtime configuration example.

# Copy to config/whitenight.yaml and edit locally.
# Precedence: defaults < this file < WHITENIGHT_* environment variables.
# Never store real secrets here; credentials belong in macOS Keychain.

app_name: WhiteNight
app_env: development        # development | test | production

# The first release is localhost-only. Binding to 0.0.0.0 breaks that boundary.
host: 127.0.0.1
port: 8765

log_level: INFO
log_json: false             # Set true for structured JSON logs in production.

data_dir: data

# Development/test: sqlite:///data/whitenight.db
# Encrypted production: sqlcipher:///data/whitenight.db (requires the sqlcipher extra)
database_url: sqlite:///data/whitenight.db

keychain_backend: macos     # macos | memory (memory is for tests only)
keychain_service: com.whitenight.credentials

# --- Model and context ---
# Temporary baseline: text model + SOUL.md. Return to qwen3-vl after LoRA validation.
model_name: qwen3:8b
model_provider: ollama       # ollama | openai
openai_base_url: https://api.openai.com/v1
openai_api_key_account: openai_api_key
openai_timeout_s: 120.0
model_supports_vision: false   # Set true when returning to qwen3-vl:8b.
model_max_output_tokens: 2048  # Ollama num_predict cap prevents runaway generation.
model_context_tokens: 32768
# Optional local HuggingFace tokenizer.json. Empty means Provider-enforced context only.
model_tokenizer_path:
ollama_keep_alive: "-1"        # -1 keeps the model loaded; durations such as 5m/1h also work.
ollama_base_url: http://127.0.0.1:11434
context_budget_chars: 12000
max_image_bytes: 8388608    # 8 MiB
soul_file: SOUL.md

# Memory extraction: ollama (async after reply) | rules (fallback) | none
memory_extractor: ollama
memory_extract_max_tokens: 512  # Limit extraction so it yields the inference slot to chat.
# Empty means FTS5 lexical retrieval only.
embedding_model: ""

# Delegated executors (stage 5)
hermes_gateway_url: http://127.0.0.1:9119
hermes_managed: true
hermes_command: hermes
hermes_provider: custom
hermes_model: qwen3-vl:8b
hermes_inference_base_url: http://127.0.0.1:11434/v1
hermes_startup_timeout_s: 45.0
deepseek_api_key_account: deepseek_api_key
volc_search_api_key_account: volc_search_api_key
volc_search_endpoint: https://open.feedcoopapi.com/search_api/global_search
volc_search_timeout_s: 20.0
codex_command: codex
codex_timeout_s: 1800

# Proactive-message defaults (stage 7; WebUI changes are persisted)
proactive_enabled: false
proactive_expected_per_day: 1.5
proactive_quiet_start: "23:00"
proactive_quiet_end: "08:00"
proactive_suppress_minutes: 60
proactive_skip_grace_minutes: 45
proactive_sender: log           # log | none | qq (select qq after NapCat setup)

# QQ / OneBot (stage 8; NapCat login requires user interaction)
qq_enabled: false
qq_owner_ids: []                # Example: [10001]
qq_onebot_api_url: http://127.0.0.1:3000
qq_rate_limit_seconds: 2.0
qq_reply_max_chars: 4000
qq_file_send_max_bytes: 104857600
